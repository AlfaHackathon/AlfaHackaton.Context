<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>AlfaHackaton.Context</PackageId>
    <Version>1.0.1</Version>
    <Authors>AlfaHackathon</Authors>
    <RepositoryUrl>https://github.com/AlfaHackathon/AlfaHackaton.Context</RepositoryUrl>
    <Description>Request context and authorized user data for .NET applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
